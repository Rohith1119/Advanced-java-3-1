import java.sql.*;

public class StaffPreparedJDBC {
    public static void main(String[] args) {

        String url = "jdbc:mysql://localhost:3306/staff_db";
        String user = "root";
        String password = "Root@123";

        try {
            // Load Driver
            Class.forName("com.mysql.cj.jdbc.Driver");

            // Establish Connection
            Connection con = DriverManager.getConnection(url, user, password);
            System.out.println("Connected Successfully!");

            // ---------------- INSERT ----------------
            String insert = "INSERT INTO staff(staff_id, staff_name, salary) VALUES(?,?,?)";
            PreparedStatement psInsert = con.prepareStatement(insert);

            psInsert.setInt(1, 101);
            psInsert.setString(2, "Ravi");
            psInsert.setDouble(3, 35000);

            int i = psInsert.executeUpdate();
            System.out.println(i + " Record Inserted");

            // ---------------- UPDATE ----------------
            String update = "UPDATE staff SET salary=? WHERE staff_id=?";
            PreparedStatement psUpdate = con.prepareStatement(update);

            psUpdate.setDouble(1, 40000);
            psUpdate.setInt(2, 101);

            int u = psUpdate.executeUpdate();
            System.out.println(u + " Record Updated");

            // ---------------- DISPLAY ----------------
            String display = "SELECT * FROM staff";
            PreparedStatement psDisplay = con.prepareStatement(display);

            ResultSet rs = psDisplay.executeQuery();

            System.out.println("\nStaff Records");
            System.out.println("-----------------------------");
            while (rs.next()) {
                System.out.println(
                        rs.getInt("staff_id") + " " +
                        rs.getString("staff_name") + " " +
                        rs.getDouble("salary"));
            }

            // ---------------- DELETE ----------------
            String delete = "DELETE FROM staff WHERE staff_id=?";
            PreparedStatement psDelete = con.prepareStatement(delete);

            psDelete.setInt(1, 101);

            int d = psDelete.executeUpdate();
            System.out.println("\n" + d + " Record Deleted");

            // Close Resources
            rs.close();
            psInsert.close();
            psUpdate.close();
            psDisplay.close();
            psDelete.close();
            con.close();

            System.out.println("Connection Closed.");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
